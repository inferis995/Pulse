{
  "name": "pulse-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse Bridge \u2014 MCP server that lets AI apps (OpenCode, Claude, Cursor, VS Code) read Pulse Windows diagnostics, read-only",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "pulse-bridge": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pdfkit": "^0.19.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skill"
  ]
}
